#include <iostream>
using namespace std;

constexpr long long INNER_FARE = 1000;
constexpr long long MIDDLE_FARE = 2000;
constexpr long long OUTER_FARE = 3000;
constexpr int PEAK_SURCHARGE = 20;
constexpr long long MIN_BALANCE = 5000;

enum class Zone {
    Inner,
    Middle,
    Outer
};

long long getFare(Zone zone) {
    switch (zone) {
        case Zone::Inner:
            return INNER_FARE;

        case Zone::Middle:
            return MIDDLE_FARE;

        case Zone::Outer:
            return OUTER_FARE;
    }

    return 0;
}

int main() {
    cout << "Inner Fare: Rs " << INNER_FARE / 100 << '\n';
    cout << "Middle Fare: Rs " << MIDDLE_FARE / 100 << '\n';
    cout << "Outer Fare: Rs " << OUTER_FARE / 100 << '\n';

    cout << "Peak Surcharge: " << PEAK_SURCHARGE << "%\n";
    cout << "Minimum Balance: Rs " << MIN_BALANCE / 100 << '\n';

    cout << "Selected Fare: Rs "
         << getFare(Zone::Outer) / 100 << '\n';

    return 0;
}
